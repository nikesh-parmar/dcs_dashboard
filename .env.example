# Loomi Connect MCP endpoints (region-specific)
# Comma-separated list — the app connects to each and merges orgs/projects.
# Options: eu | uk | us | ca | ap
LOOMI_MCP_URLS=https://eu.connect.loomi.ai/mcp,https://uk.connect.loomi.ai/mcp

# Legacy single-endpoint fallback (used only if LOOMI_MCP_URLS is empty)
# LOOMI_MCP_URL=https://eu.connect.loomi.ai/mcp

# Bloomreach Glean MCP — client overview + vertical above Project overview
GLEAN_MCP_URL=https://bloomreach-be.glean.com/mcp/default

# Local app (defaults work for laptop use)
PORT=3847
HOST=localhost

# --- Render / cloud hosting ---
# Public URL used for OAuth callbacks (no trailing slash).
# On Render, RENDER_EXTERNAL_URL is set automatically — override only if needed.
# APP_BASE_URL=https://your-service.onrender.com

# Interface to bind (Render needs 0.0.0.0; local default is localhost)
# BIND_HOST=0.0.0.0

# Persist OAuth tokens (mount a Render disk here, e.g. /var/data)
# DATA_DIR=/var/data
